                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.95, sum by (le) (rate(portal_http_server_duration_bucket{job=~\"$job\"}[5m]))) / 1000",
                        "legendFormat": "P95",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "dg1avyzdsfg8wb"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "histogram_quantile(0.99, sum by (le) (rate(portal_http_server_duration_bucket{job=~\"$job\"}[5m]))) / 1000",
                        "legendFormat": "P99",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "C"
