# Portal relay configuration.

# Opt-in static cache capability (ordinary tunnels remain uncached).
# Disposable cache storage lives under IDENTITY_PATH/static-cache.
CACHE_ENABLED=true
CACHE_MAX_BYTES=1073741824
CACHE_MAX_TTL=24h
#
# Copy to .env and edit. Keys may be consumed by the relay binary, Docker
# Compose, the container image, or an external provider SDK as documented below.
#
# Check the relay configuration before starting anything. The report gives the
# effective value and source of every key the relay reads and reports
# side-effect-free validation errors. Compose-only and external SDK variables
# remain owned by this deployment and are not interpreted by the relay binary:
#
#   docker compose run --rm -T portal config
#
# No --env-file: Compose has already built the container's environment from this
# file plus its own defaults, so the report describes what `docker compose up`
# will actually run. Passing --env-file instead reads the file against the relay
# binary's defaults, which differ -- MIN_PORT is 0 there and 40000 under Compose
# -- and would report features as blocked that the deployment enables.
#
# -T because `docker compose run` asks for a TTY otherwise, and older versions
# fail with "the input device is not a TTY".
#
# API_PORT and SNI_PORT are deliberately absent. The bundled topology fixes them
# at 4017 and 443 because the relay reaches its own API listener through its SNI
# router; overriding them breaks that wiring rather than moving it.


# ─────────────────────────────────────────────────────────────────────────────
# 1. Required
# ─────────────────────────────────────────────────────────────────────────────

# Public HTTPS origin browsers and tunnel clients use, including its public
# port. Must be publicly resolvable when DISCOVERY=true; localhost and other
# local-only names are rejected by public discovery. SNI_PORT controls only the
# local listener, does not change this advertised origin, and follows this
# URL's explicit port when SNI_PORT is unset.
PORTAL_URL=https://localhost

# Optional IVNP RouterConfig JSON file; requires DISCOVERY=true.
# Empty disables the overlay. A file containing {} uses IVNP's in-memory defaults.
# Legacy ivnp.conf files must be replaced; see docs /configuration#ivnp-overlay.
IVNP_CONFIG=

# Bearer token for the admin and policy APIs. Leaving this empty leaves those
# APIs unauthenticated. Generate one with: openssl rand -hex 32
ADMIN_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
# 2. Storage and ports
# ─────────────────────────────────────────────────────────────────────────────

# Directory for relay identity, policy state, and certificate material.
# Also the in-container mount point for ./.portal-certs.
IDENTITY_PATH=/portal-certs


# Compose publishes this port.

# Optional HTTP redirect listener, disabled by default. Requires an HTTPS
# PORTAL_URL and redirects to that fixed URL, ignoring incoming host/path/query.
# Publish TCP port 80 only when enabled.
HTTP_REDIRECT_ENABLED=false
HTTP_REDIRECT_ADDR=:80

# Optional HSTS: max-age=31536000, without includeSubDomains or preload.
# Browsers ignore HSTS received over HTTP.
HTTP_REDIRECT_HSTS=false

# Inclusive lease port range shared by the UDP and raw TCP transports.
# 0 disables both. Enabling a transport without a range does nothing; the relay
# reports that at startup. Publish the same range in docker-compose.yml when set.
MIN_PORT=0
MAX_PORT=0


# ─────────────────────────────────────────────────────────────────────────────
# 3. Feature toggles - the defaults suit a single private relay
# ─────────────────────────────────────────────────────────────────────────────

# Serve relay discovery endpoints and poll discovery peers. Requires a publicly
# reachable PORTAL_URL.
DISCOVERY=true

# Comma-separated relay API URLs to seed discovery from.
BOOTSTRAPS=

# Enable the UDP and raw TCP lease transports. Both need MIN_PORT/MAX_PORT.
UDP_ENABLED=false
TCP_ENABLED=false

# Initial landing-page state. Admin changes are persisted in policy.json.
LANDING_PAGE_ENABLED=false

# Directory inside the container holding a custom SPA index.html. Leave empty to
# serve the frontend embedded in the binary. Uncomment the matching mount in
# docker-compose.yml when setting this.
PORTAL_FRONTEND_DIR=

# Trust X-Forwarded-* and X-Real-IP. Portal owns its public port in the bundled
# topology, so client addresses already come from the socket; enable this only
# when a proxy you control genuinely sits in front. Set TRUSTED_PROXY_CIDRS to
# that proxy's fixed address (/32 for IPv4, /128 for IPv6); empty trusts no
# proxies and uses socket addresses even with TRUST_PROXY_HEADERS=true.
# The proxy must overwrite X-Forwarded-For and X-Real-IP with the client address.
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=

# Relay-owned Sui x402 facilitator under /api/x402.
# X402_ENABLED=true without X402_PAY_TO cannot receive payments.
X402_ENABLED=false
X402_TESTNET=false
X402_PAY_TO=

# Service reputation voting under /api/reputation. The relay stores votes per
# public hostname (voter IDs and client IPs only as HMACs) in
# reputation.json inside IDENTITY_PATH and computes the service warning as
# total >= REPUTATION_MIN_TOTAL AND down >= REPUTATION_MIN_DOWN AND
# down_ratio >= REPUTATION_DOWN_RATIO_PERCENT/100. Hostnames stay "new" and
# owner-key changes stay flagged for REPUTATION_PROBATION; entries unseen in
# the public lease set for REPUTATION_RETENTION are pruned. The last two
# REPUTATION_VOTE_* keys bound per-source vote admission.
REPUTATION_DOWN_RATIO_PERCENT=70
# Relay-wide cap on hostnames with votes; when full, the oldest voteless hostname
# is evicted — voted hostnames are never evicted and overflow gets 429.
REPUTATION_MAX_HOSTNAMES=1024
# Maximum distinct source IPs that may hold cookieless minted voter IDs. New
# sources beyond the cap get 429 (fail-closed); existing sources keep their budgets.
REPUTATION_MAX_MINT_SOURCES=4096
# Maximum distinct voters per hostname; new voters get 429; existing voters can still change vote.
REPUTATION_MAX_VOTERS_PER_HOSTNAME=512
# Maximum cookieless voter IDs a single source IP may mint. In-memory only; resets on restart.
# Default (2) is below MinDown (3) so cookieless minting alone cannot trigger a warning.
REPUTATION_MAX_VOTERS_PER_SOURCE=2
REPUTATION_MIN_DOWN=3
REPUTATION_MIN_TOTAL=5
REPUTATION_PROBATION=168h
REPUTATION_RETENTION=720h
REPUTATION_VOTE_BURST=12
REPUTATION_VOTE_PER_MINUTE=6

# pprof diagnostics. Keep the address on loopback unless the port is otherwise
# protected. PPROF_PORT only matters when you also uncomment the pprof port
# mapping in docker-compose.yml, which exposes it to the host.
PPROF_ENABLED=false
PPROF_ADDR=127.0.0.1:6060
# PPROF_PORT=6060


# ─────────────────────────────────────────────────────────────────────────────
# 4. DNS provider - embedded is canonical; cloud providers are supported
#
# Used for ACME DNS-01, managed A records, the relay ECH record,
# opt-in tunnel ECH records, and optional ENS DNS automation. Unset means
# embedded, not "off": to manage certificates yourself instead, place
# valid fullchain.pem and privatekey.pem under IDENTITY_PATH with neither
# acme-account.key nor acme-registration.json present. Manual certificates bypass
# issuance. Embedded A-record synchronization stays enabled; external-provider
# A records must be managed separately. ECH and opt-in ENS still use the selected
# provider and may require its API credentials.
#
# The six cloud providers below are supported first-class backends.
# Only one provider's credentials are ever read. The unused blocks below stay
# commented out on purpose.
# ─────────────────────────────────────────────────────────────────────────────

# embedded (default) | cloudflare | gcloud | hetzner | njalla | route53 | vultr
ACME_DNS_PROVIDER=embedded

#   -> ACME_DNS_PROVIDER=embedded
#      An authoritative DNS server inside the relay, so no provider API
#      credentials are needed. Requires a one-time NS delegation of the base
#      domain at the parent zone (NS portal.example.com -> ns.portal.example.com
#      with a glue A record to the relay IP) and open 53/tcp + 53/udp. A
#      container running without root needs CAP_NET_BIND_SERVICE to bind 53.
#      Supports TXT records and DNSSEC with a persistent CSK stored at
#      IDENTITY_PATH/dnssec-csk.json; preserve this key across restarts.
#      Manually publish the DS record printed at startup in the parent zone,
#      alongside the NS/glue delegation, with a valid parent DNSSEC chain.
EMBEDDED_DNS_PORT=53

#   -> ACME_DNS_PROVIDER=cloudflare
#      The token needs Zone:Read as well as DNS:Edit. DNS:Edit alone cannot
#      locate the zone, and issuance fails with "no cloudflare zone found".
# CLOUDFLARE_TOKEN=

#   -> ACME_DNS_PROVIDER=gcloud
#      Project is auto-detected from ADC or GCE metadata when omitted.
#      GOOGLE_APPLICATION_CREDENTIALS is read by the Google Cloud SDK itself,
#      not by a relay flag: mount the service account file and point this at
#      the in-container path.
# GCP_PROJECT_ID=
# GCP_MANAGED_ZONE=
# GOOGLE_APPLICATION_CREDENTIALS=

#   -> ACME_DNS_PROVIDER=hetzner
# HETZNER_API_TOKEN=

#   -> ACME_DNS_PROVIDER=route53
#      Omit the static keys to use the default AWS credential chain.
#      AWS_DNSSEC_KMS_KEY_ARN is needed only with ENS_GASLESS_ENABLED=true when
#      no ACTIVE KSK exists yet.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_REGION=
# AWS_HOSTED_ZONE_ID=
# AWS_DNSSEC_KMS_KEY_ARN=

#   -> ACME_DNS_PROVIDER=vultr
# VULTR_API_KEY=

#   -> ACME_DNS_PROVIDER=njalla
# NJALLA_TOKEN=

# ENS gasless DNS import automation is opt-in on public relay domains.
# Embedded TXT+DNSSEC requires manual parent DS publication and a valid parent
# chain. Portal does not authenticate that chain: embedded ENS status stays
# pending/unverified even after DS propagation, and synchronization continues.
# Cloudflare, gcloud, Route53, and Vultr use their provider APIs instead;
# Hetzner and Njalla do not support ENS DNSSEC automation.
# Not needed for normal relay operation; leave false unless you specifically
# want it.
ENS_GASLESS_ENABLED=false

# Automatic pre-auth admission (in-memory, weighted budgets)
# Source-IP units refilled per minute
# PREAUTH_SOURCE_PER_MINUTE=10
# Source-IP burst capacity
# PREAUTH_SOURCE_BURST=20
# Relay-wide units refilled per minute
# PREAUTH_GLOBAL_PER_MINUTE=600
# Relay-wide burst capacity
# PREAUTH_GLOBAL_BURST=200
# Units per registration challenge
# PREAUTH_CHALLENGE_COST=1
# Units per discovery announce
# PREAUTH_ANNOUNCE_COST=2
# Units per registration attempt
# PREAUTH_REGISTER_COST=5
