    "@radix-ui/react-tooltip": "^1.4.1",
    "@ssgoi/react": "^7.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
